<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Tremors.ico</ApplicationIcon>
    <RootNamespace>Tremors</RootNamespace>
    <AssemblyName>Tremors</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.1.1</Version>
    <Product>Tremors</Product>
    <Authors>Jeroen Jonckheer</Authors>
    <Description>Calm mouse movement for people with a tremor. Free and open source.</Description>
    <Copyright>Copyright © 2026 Jeroen Jonckheer</Copyright>
    <RepositoryUrl>https://github.com/JeroenJonckheer/Tremors</RepositoryUrl>
  </PropertyGroup>

  <!-- dotnet publish -c Release  →  dist\Tremors.exe, one file, no .NET install needed -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\dist\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tremors.Tests" />
    <InternalsVisibleTo Include="DemoTrace" />
  </ItemGroup>

</Project>
